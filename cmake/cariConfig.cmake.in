@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@CARI_HAVE_ZMQ@)
    find_dependency(PkgConfig)
    pkg_check_modules(ZMQ REQUIRED IMPORTED_TARGET libzmq)
    find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/cariTargets.cmake")
set(CARI_HAVE_FLAC @CARI_HAVE_FLAC@)
set(CARI_HAVE_ZMQ @CARI_HAVE_ZMQ@)
