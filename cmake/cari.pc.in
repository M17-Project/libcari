prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libcari
Description: CARI 2.1 (Common Amateur Radio Interface) protocol library
Version: @PROJECT_VERSION@
Requires.private:@CARI_PC_REQUIRES@
Libs: -L${libdir} -lcari
Cflags: -I${includedir}
